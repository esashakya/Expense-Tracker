@page "/Dashboard"
@using Expense_Tracker.Models
@using Expense_Tracker.Services
@inject AuthenticationStateService _authStateService
@inject NavigationManager navigationManager
@inject IDashboardService dashboardService
@inject IDebtService debtService
@using System.Text.Json;
@*header *@

<div class="container mt-4">
    <div class="row d-flex justify-content-around">
        <div class="col-md-3 align-self-center top-shadow p-3 mb-5 rounded" style="background-color: #f8f9fa;">
            <h3 class="text-center">Cash Inflows</h3>
            <h5 class="text-center">@totalInflow</h5>
        </div>
        <div class="col-md-3 align-self-center top-shadow p-3 mb-5 rounded" style="background-color: #f8f9fa;">
            <h3 class="text-center">Cash Outflows</h3>
            <h5 class="text-center">@totalOutflow</h5>
        </div>
        <div class="col-md-3 align-self-center top-shadow p-3 mb-5 rounded" style="background-color: #f8f9fa;">
            <h3 class="text-center">Debt</h3>
            <h5 class="text-center">@totalDebt</h5>
        </div>
    </div>
    <div class="row justify-content-around">
        @{
            decimal totalTransactions =@total;
        }
        <div class="col-md-3 align-self-center top-shadow p-3 mb-5 rounded" style="background-color: #f8f9fa;">
            <h3 class="text-center">Total Transactions</h3>
            <h5 class="text-center">@totalTransactions </h5>
        </div>
        <div class="col-md-3 align-self-center bottom-shadow p-3 mb-5 rounded" style="background-color: #f8f9fa;color:#007c29;">
            <h3 class="text-center">Clear Debt</h3>
            <h5 class="text-center">@totalCleared</h5>
        </div>
        <div class="col-md-3 align-self-center bottom-warning-shadow p-3 mb-5 rounded" style="background-color: #f8f9fa; color: #de3b40;">
            <h3 class="text-center">Remaining Debt</h3>
            <h5 class="text-center">@totalPending</h5>
        </div>
    </div>
</div>
<div class="container mt-4">
    <div class="row"> 
        <div class="col-md-6">
            <PieChart  />
        </div>
        <div class="col-md-6">
            <div class="container m-4 p-3 mt-3 shadow rounded">
                <div class="d-flex flex-row justify-content-around">
                    <div><h5 class="pt-3 fw-bold">Top 5 Transactions</h5></div>


                    <div class="dropdown">
                        <button class="btn " type="button"  data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #daecfa; border-style:none; color: #171a1f;">
                            Sort By
                        </button>
                        @{
                            string date = "Date";
                            string transactionInflow = "Inflow";
                            string transactionOutflow = "Outflow";
                            string transactionDebt = "Debt";
                            string tag = "Tag";
                        }
                        <ul class="dropdown-menu" >
                            <li><button class="dropdown-item" @onclick="() => SortData(date)">Date</button></li>
                            <li><button class="dropdown-item" @onclick="() =>SortData(transactionInflow)">Inflow</button></li>
                            <li><button class="dropdown-item" @onclick="() => SortData(transactionOutflow)">Outflow</button></li>
                            <li><button class="dropdown-item" @onclick="() => SortData(transactionDebt)">Debt</button></li>
                            <li><button class="dropdown-item" @onclick="() => SortData(tag)">Tags</button></li>
                        </ul>
                    </div>
                </div>
                <table class="table">
                  <thead>
                     <tr class="table-primary">
                      <th scope="col">Sn.no</th>
                      <th scope="col">Title</th>
                      <th scope="col">Amount</th>
                      <th scope="col">Date</th>
                      <th scope="col">Tag</th>
                      <th scope="col">Labels</th>
                      <th scope="col">Notes</th>
                    </tr>
                  </thead>
                  <tbody>
                        @{
                            int counter = 1;
                            
                        }
                        @foreach (var transaction in totalTransaction.Take(5))
                        {
                            <tr class="table-light">

                                <th scope="row" class="table-light">@counter</th>

                                <td class="table-light">@transaction.transaction_title</td>
                                <td class="table-light">@transaction.transaction_amount.ToString()</td>
                                <td class="table-light">@transaction.transaction_date.ToString("yyyy-MM-dd")</td>
                                <td class="table-light text-primary">@transaction.transaction_tag</td>
                                <td class="table-light @(transaction.transaction_label =="Credit" ? "text-success" : "text-danger" )">@transaction.transaction_label</td>
                                <td class="table-light">@transaction.transaction_note</td>
                        </tr>
                        counter++;
                        }
                </tbody>
                </table>
                 
            </div>
         </div>
                
    </div>
 </div>
 @*pending debts*@
 <div class="d-flex justify-content-center align-items-center">
 <div class="container  p-3  shadow rounded " style="margin: 60px;">
    <div class="d-flex flex-row justify-content-around mb-4">
        <div><h5 class="pt-3 fw-bold">Pending Debts</h5></div>

         <div class="dropdown">
             <button class="btn " type="button"  data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #daecfa; border-style:none; color: #171a1f;">
                            Sort By
              </button>
                
                        <ul class="dropdown-menu" >
                            <li><a class="dropdown-item" @onclick="DatePending">Date</a></li>
                            <li><a class="dropdown-item" @onclick="DescPending">Highest</a></li>
                            <li><a class="dropdown-item" @onclick="LowestPending">Lowest</a></li>
                        </ul>
                    </div>
    </div>
                <table class="table">
                  <thead>
                     <tr class="table-primary">
                      <th scope="col">Sn.no</th>
                      <th scope="col">Title</th>
                      <th scope="col">Amount</th>
                      <th scope="col">Date</th>
                      <th scope="col">Due Date</th>
                      <th scope="col">Tag</th>
                      <th scope="col">Labels</th>
                      <th scope="col">Notes</th>
                      <th scope="col">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                        @{
                            int ncounter = 1;
                        }
                        @foreach (var PendingTransaction in debts)
                        {
                            <tr class="table-light">

                                <th scope="row" class="table-light">@ncounter</th>

                            <td class="table-light">@PendingTransaction.debt_title</td>
                            <td class="table-light">@PendingTransaction.debt_amount.ToString()</td>
                            <td class="table-light">@PendingTransaction.debt_date.ToString("yyyy-MM-dd")</td>
                            <td class="table-light">@PendingTransaction.debt_duedate.ToString("yyyy-MM-dd")</td>
                            <td class="table-light text-primary">@PendingTransaction.debt_tag</td>
                            <td class="table-light text-warning">@PendingTransaction.debt_label</td>
                            <td class="table-light">@PendingTransaction.debt_note</td>
                            <td class="table-light"><div class="btn btn-danger" style="border-radius: 15px; margin:0;">@PendingTransaction.debt_status</div></td>
                        </tr>
                        ncounter++;
                        }
                </tbody>
                </table>
                 
            </div>
            </div>
     
@code {
    protected override void OnInitialized()
    { 
        Total();
    }
    private decimal totalInflow;
    private decimal totalOutflow;
    private decimal total;
    private decimal totalDebt;
    private decimal totalPending;
    private decimal totalCleared;
    private string errorMessage;

    private List<Debt> DebtItems = new List<Debt>();
    private List<Debt> debts = new List<Debt>();
    private List<Transaction> totalTransaction = new List<Transaction>();

    protected override async Task OnInitializedAsync()
    {
        await Total();
        await DebtList();
        await AllTransaction();

    }
    private async Task AllTransaction()
    {
        var authenticatedUser = _authStateService.GetAuthenticatedUser();
        int id = authenticatedUser.user_id;
        totalTransaction = await dashboardService.ListTransactions(id);
        totalTransaction = totalTransaction.OrderBy(t => t.transaction_amount).ToList();
    }
    private async Task SortData(string typeSorting)
    {
        if (typeSorting == "Date")
        {
            totalTransaction = totalTransaction.OrderByDescending(t => t.transaction_date).ToList();
        }
        else if (typeSorting == "Inflow")
        {
            totalTransaction = totalTransaction.Where(t => t.transaction_label == "Inflow").OrderByDescending(t => t.transaction_amount).ToList();
        }
        else if (typeSorting == "Outflow")
        {
            totalTransaction = totalTransaction.Where(t => t.transaction_label == "Outflow").OrderByDescending(t => t.transaction_amount).ToList();
        }
        else if (typeSorting == "Debt")
        {
            totalTransaction = totalTransaction.Where(t => t.transaction_label == "Debt").OrderByDescending(t => t.transaction_amount).ToList();
        }
        else
        {
            totalTransaction = totalTransaction.OrderBy(t => t.transaction_tag).OrderByDescending(t => t.transaction_amount).ToList();
        }
        StateHasChanged();
    }

    private async Task Total()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser();
            int id = authenticatedUser.user_id;
            totalInflow = await dashboardService.CalculateTotalInflowAsync(id);
            totalOutflow = await dashboardService.CalculateTotalOutflowAsync(id);
            (decimal TotalDebt, decimal TotalPending, decimal TotalCleared) = await dashboardService.CalculateTotalDebtAsync(id);
            totalDebt = TotalDebt;
            totalPending = TotalPending;
            totalCleared = TotalCleared;
            total = totalInflow + totalPending - totalOutflow;

        }
        catch (Exception ex)
        {
            errorMessage = "Please try again later. There is some problem while calculating the total";
        }
    }
    private async Task DebtList()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser(); //to get loggedin user id
            int id = authenticatedUser.user_id;
            DebtItems = await debtService.GetDebtsByUserIdAsync(id); //provide the loggedin user id as parameter
            debts = DebtItems.Where(debt => debt.debt_status == "Pending").ToList();


        }
        catch (Exception ex)
        {
            errorMessage = "Please try again later. There is some problem while collecting debt details.";
        }
    }
    private async Task DescPending()
    {
        debts = debts.OrderByDescending(d => d.debt_amount).ToList();
    }
    private async Task LowestPending()
    {
        debts = debts.OrderBy(d => d.debt_amount).ToList();
    }
    private async Task DatePending()
    {
        debts = debts.OrderByDescending(d => d.debt_date).ToList();
    }
    

}