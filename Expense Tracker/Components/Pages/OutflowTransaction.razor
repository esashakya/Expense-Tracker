@page "/Outflow"
@inject NavigationManager navigationManager
@using Expense_Tracker.Models
@using Expense_Tracker.Services
@inject AuthenticationStateService _authStateService
@inject IDashboardService dashboardService
@inject IOutflowService outflowService
<div class="container">
    <div class="d-flex flex-column align-items-center">
        <h2 class="text-center fw-bold" style="color:#0f4c7b;">CASH OUTFLOW</h2>
        @if (!string.IsNullOrEmpty(ouflowMessage))
        {
            <div class=" shadow  p-1  mb-2 align-self-center" style="background-color: #197dca; border-radius: 7px;">
                <p class="text-light text-center  fw-bold ">@ouflowMessage</p>
            </div>
        }
        <div class="background-blue p-3 m-4 text-center">
            <h3 class="fw-bold"><span>Total Amount:</span>@total</h3>
        </div>
        <div class="row">
            <div class="col-md-6">
                <h5 class="text-success">Highest Outflow: @highestOutflow</h5>
            </div>
            <div class="col-md-6">
                <h5 class="text-primary">Lowest Outflow: @lowestOutflow</h5>
            </div>
        </div>
    </div>
    
    <div class="row justify-content-evenly" style=" margin: 3%;margin-left: 12%;">
        <div class="col-md-3">
            <label for="startDateRange">Start Date Range</label>
            <input type="date" @bind="startDateRange" class="form-control" />
        </div>
        <div class="col-md-3">
            <label for="endDateRange">End Date Range</label>
            <input type="date" @bind="endDateRange" class="form-control" />
        </div>
        <div class="col-md-2">
            <label for="filterTag">Filter By Tag</label>
            <select class="form-control" @bind="filterTag">
                <option value="defaultText" selected disabled hidden>Select Tag</option>
                <option value="Gadgets">Gadgets</option>
                <option value="Clothes">Clothes</option>
                <option value="Groceries">Groceries</option>
            </select>
        </div>
        <div class="col-md-2 align-self-center">
            <button class="btn btn-primary mt-4" type="button" @onclick="FilterByDate">Apply Filter</button>
        </div>
        <div class="col-md-2 align-self-center mt-2">
            <button class="btn btn-primary mt-4" type="button" @onclick="ClearFilterByDate">Clear Filter</button>
        </div>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class=" shadow  mb-2 align-self-center" style="background-color: #197dca; border-radius: 7px;">
                <p class="text-light text-center  fw-bold ">@errorMessage</p>
            </div>
        }
    </div>
    <div class="mb-5" style="margin-left: 25%; ">
        <div class="d-flex flex-row">
            <div class="col-md-6">
                <div>
                    <button type="button" class="btn btn-primary" @onclick="OpenTransaction">Add Transaction</button>
                </div>
            </div>
            <div class="col-md-6" style="margin-left:30px;">
                <h5><span class="text-blue">Date:</span>@DateTime.Now.ToString("yyyy-MM-dd")</h5>
            </div>

        </div>
    </div>
    <form class="d-flex" style="width:25%;">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" @bind= "searchOutflowTitle">
        <button class="btn btn-outline-primary" type="button" @onclick="SearchByTitle">Search</button>
    </form>
</div>
<div class="d-flex justify-content-center align-items-center">
    <div class="container m-4 p-3 mt-3 shadow rounded" style="margin-left: 25%;">
        <div class="d-flex flex-row justify-content-end mb-3">



            <div class="dropdown">
                <button class="btn " type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #daecfa; border-style:none; color: #171a1f;">
                    Sort By
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" @onclick="LatestDateOutflow">Latest Date</a></li>
                    <li><a class="dropdown-item" @onclick="OldestDateOutflow">Oldest Date</a></li>
                    
                </ul>
            </div>
        </div>
        <table class="table">
            <thead>
                <tr class="table-primary">
                    <th scope="col">Sn.no</th>
                    <th scope="col">Title</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Date</th>
                    <th scope="col">Tag</th>
                    <th scope="col">Labels</th>
                    <th scope="col">Notes</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int counter = 1;
                }
                @if (filterOutflowItems == null){
                foreach (var OutflowItem in OutflowItems)
                {
                    <tr class="table-light">

                        <th scope="row" class="table-light">@counter</th>

                        <td class="table-light">@OutflowItem.outflow_title</td>
                        <td class="table-light">@OutflowItem.outflow_amount.ToString()</td>
                        <td class="table-light">@OutflowItem.outflow_date.ToString("yyyy-MM-dd")</td>
                        <td class="table-light text-primary">@OutflowItem.outflow_tag</td>
                        <td class="table-light text-warning">@OutflowItem.outflow_label</td>
                        <td class="table-light">@OutflowItem.outflow_note</td>
                        </tr>
                        counter++;
                    }
                }
                else
                {
                    foreach (var filterOutflowItem in filterOutflowItems)
                    {
                        <tr class="table-light">

                            <th scope="row" class="table-light">@counter</th>

                            <td class="table-light">@filterOutflowItem.outflow_title</td>
                            <td class="table-light">@filterOutflowItem.outflow_amount.ToString()</td>
                            <td class="table-light">@filterOutflowItem.outflow_date.ToString("yyyy-MM-dd")</td>
                            
                            <td class="table-light text-primary">@filterOutflowItem.outflow_tag</td>
                            <td class="table-light text-warning">@filterOutflowItem.outflow_label</td>
                            <td class="table-light">@filterOutflowItem.outflow_note</td>
                         </tr>
                        counter++;
                    }
                }
            </tbody>
        </table>

    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        filterOutflowItems = null;
    }

    private void OpenTransaction()
    {
        navigationManager.NavigateTo("/AddTransaction");
    }

    private decimal totalInflow;
    private decimal totalOutflow;
    private decimal total;
    private string errorMessage;
    private string ouflowMessage;
    private string searchOutflowTitle;
    private decimal highestOutflow;
    private decimal lowestOutflow;
    private List<Outflow> filterOutflowItems = new List<Outflow>();
    private List<Outflow> OutflowItems = new List<Outflow>();
    private List<Outflow> outflowAmt = new List<Outflow>();
    protected override async Task OnInitializedAsync()
    {
        await Total();
        await OutflowList();



    }
    private DateTime? startDateRange;
    private DateTime? endDateRange;
    private string filterTag;
    private async Task FilterByDate()
    {
        if (startDateRange.HasValue && endDateRange.HasValue && filterTag != null)
        {
            OutflowItems = OutflowItems
                .Where(t => t.outflow_date >= startDateRange.Value && t.outflow_date <= endDateRange.Value && t.outflow_tag == filterTag) //provide the data
                .ToList();
            errorMessage = "";

        }
        else if (startDateRange.HasValue && endDateRange.HasValue)
        {
            OutflowItems = OutflowItems
                .Where(t => t.outflow_date >= startDateRange.Value && t.outflow_date <= endDateRange.Value) //provide the data
                .ToList();
            errorMessage = "";
        }
        else
        {
            errorMessage = "All the fields must be filled.";
        }


        StateHasChanged();
    }
    private async Task ClearFilterByDate()
    {
       await OnInitializedAsync();
    }
    private async Task Total()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser();
            int id = authenticatedUser.user_id;
            totalInflow = await dashboardService.CalculateTotalInflowAsync(id);
            totalOutflow = await dashboardService.CalculateTotalOutflowAsync(id);
            (decimal TotalDebt, decimal TotalPending, decimal TotalCleared) = await dashboardService.CalculateTotalDebtAsync(id);
            total = totalInflow + TotalDebt - totalOutflow;
            outflowAmt = await outflowService.GetOutflowsByUserIdAsync(id);
            highestOutflow = outflowAmt.Max(i => i.outflow_amount);
            lowestOutflow = outflowAmt.Min(i => i.outflow_amount);

        }
        catch (Exception ex)
        {
            string ouflowMessage = "Please refresh the page to get the transaction details.";
        }
    }
    private async Task OutflowList()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser();
            int id = authenticatedUser.user_id;
            OutflowItems = await outflowService.GetOutflowsByUserIdAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = "Please refresh the page.";
        }
    }
    private async Task SearchByTitle()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser(); //to get loggedin user id
            int id = authenticatedUser.user_id;
            filterOutflowItems = await outflowService.GetOutflowsByTitleAsync(searchOutflowTitle, id);


            if (filterOutflowItems == null)
            {
                errorMessage = "No matched title found.";

                StateHasChanged();
            }
            else
            {
                errorMessage = null;
            }

        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while retrieving the debts";
            Console.WriteLine(errorMessage);
        }
    }
    private async Task LatestDateOutflow()
    {
        @if (filterOutflowItems == null)
        {
            OutflowItems = OutflowItems.OrderByDescending(d => d.outflow_date).ToList();
        }
        else
        {
            filterOutflowItems = filterOutflowItems.OrderByDescending(d => d.outflow_date).ToList();
        }
    }
    private async Task OldestDateOutflow()
    {
        @if (filterOutflowItems == null)
        {
            OutflowItems = OutflowItems.OrderBy(d => d.outflow_date).ToList();
        }
        else
        {
            filterOutflowItems = filterOutflowItems.OrderBy(d => d.outflow_date).ToList();
        }
    }
  
}
