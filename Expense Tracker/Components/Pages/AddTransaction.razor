@page "/AddTransaction"
 @*importing the necessary file and folders*@
@using Expense_Tracker.Models
@using Expense_Tracker.Services
@inject AuthenticationStateService _authStateService
@inject IOutflowService outflowService
@inject IInflowService inflowService
@inject IDebtService debtService
@inject IDashboardService dashboardService
<div class="container">
  <h2 class="text-center" style="color: #0f4c7b;">Add Transaction</h2>
    @if (!string.IsNullOrEmpty(displayMessage)) //display message according to the criteria
    {
        <div class=" shadow  p-1  mb-2 align-self-center" style="background-color: #197dca; border-radius: 15px;">
            <p class="text-light text-center  fw-bold fs-5">@displayMessage</p>
        </div>
    }
    <form>
       <div class="mb-3 ">
         <label for="Amount" class="form-label">Amount</label>
            <input type="number" class="form-control" @bind="newTransaction.amount" />
        </div>
        <div class="mb-3">
           <label for="Type Of Transaction" class="form-label">Type Of Transaction</label>
            <select class="form-control" @bind="newTransaction.label">
                <option value="defaultText" selected disabled hidden>Select Transaction Type</option>
                <option value="Inflow">Inflow</option>
                 <option value="Outflow">Outflow</option>
                 <option value="Debt">Debt</option>
             </select>

         </div>
        <div class="mb-3 ">
            <label for="Title" class="form-label">Title</label>
            <input type="text" class="form-control" @bind="newTransaction.title" /> 
        </div>
         <div class="mb-3">
             <label for="Date" class="form-label">Date</label>
            <input type="date" class="form-control" @bind="newTransaction.date" />
                        
          </div>
        <div class="mb-3">
            <label for="Date" class="form-label">Due Date</label>
            <input type="date" class="form-control" @bind="newTransaction.duedate" />

        </div>
          <div class="mb-3">
              <label for="Note" class="form-label">Notes</label>
            <input type="text" class="form-control" @bind="newTransaction.note" />
          </div>
            <div class="mb-3">
                <label for="Note" class="form-label">Source</label>
                <input type="text" class="form-control" @bind="newTransaction.source" />
            </div>
          <div class="mb-3">
              <label for="Tag" class="form-label">Tag</label>
            <select class="form-control" @bind="newTransaction.chosen_tag">
                 <option value="defaultText" selected disabled hidden>Select Tag</option>
                     @foreach(var tag in tags)
                            {
                    <option value="@tag">@tag</option>
                            }
               
                            
               </select>

          </div>
        <button class="btn btn-primary" type="button" @onclick="OpenCustomTag" > Add Custom</button>
     </form>
                
     @if (customTagAdditional)
        {
        <div class="m-2">
            <input type="text" c placeholder="Enter Custom Tag" @bind="custom" />
              <button class="btn btn-primary mt-2" type="button" @onclick="AddCustomTag">Add Tag</button>
               <button class="btn btn-secondary mt-2 ms-2" type="button" @onclick="CancelCustom">Cancel</button>
         </div>
                    }
        <div>
        <button type="button" class="btn mt-2" style="background-color: #f1f8fd; color: #0f4c7b;" @onclick="AddNewTransaction">Confirm Transaction</button>
                    </div>
    
                   
</div>
                
        

@code {
    private List<string> tags = new List<string>{"Clothes", "Gadgets", "Groceries" };
    private bool customTagAdditional = false;
    private string custom;
    //code for tag and to manually add the custom tag
    private void OpenCustomTag()
    {
        customTagAdditional = true;
        custom = string.Empty;
    }

    private void AddCustomTag()
    {
        if (!string.IsNullOrWhiteSpace(custom) && !tags.Contains(custom))
        {
            tags.Add(custom);
        }

        customTagAdditional = false;
    }

    private void CancelCustom()
    {
        customTagAdditional = false;
    }

    // code starts

    public class Transaction {

        public string custom_tag { get; set; }
        public string chosen_tag { get; set; }
        public DateTime date { get; set; }
        public DateTime duedate { get; set; }
        public string note { get; set; }
        public string source { get; set; }
        public string label { get; set; }
        public int amount { get; set; }
        public int user_id { get; set; }
        public string title { get; set; }


    }
    private string displayMessage;
    private string successMessage;
    private string errorMessage;
    private string messageType;
    private decimal totalInflow;
    private Transaction newTransaction = new Transaction();

    private async Task AddNewTransaction()
    {

        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser();//get loggedin user
            if (authenticatedUser == null)
            {
                errorMessage = "Please sign in to the system";
                messageType = "Error";


            }

            else
            {

                newTransaction.user_id = authenticatedUser.user_id; //assigning the loggedin user id to the transaction user_id
                decimal totalInflow = await dashboardService.CalculateTotalInflowAsync(newTransaction.user_id);
                //checking if necessary fields are filled
                if (newTransaction.amount <= 0 || newTransaction.date == DateTime.MinValue || newTransaction.label == null || newTransaction.chosen_tag == null || newTransaction.title == null || (newTransaction.label == "Debt" && (newTransaction.duedate == DateTime.MinValue || newTransaction.source == null)))
                {
                    errorMessage = "Fill all the necessary details.";
                    messageType = "Error";
                    
                }
                else
                {
                    if (newTransaction.label == "Inflow")
                    {
                        //object to store inflow details
                        var inflow = new Inflow
                            {
                                user_id = newTransaction.user_id,
                                inflow_title = newTransaction.title,
                                inflow_amount = newTransaction.amount,
                                inflow_date = newTransaction.date,
                                inflow_note = newTransaction.note,
                                inflow_label = newTransaction.label,
                                inflow_tag = newTransaction.chosen_tag,

                            };
                        await inflowService.AddInflowAsync(inflow);
                        successMessage = "Successfully added Inflow transaction";
                        messageType = "Success";
                    }
                    //object to store outflow details
                    else if (newTransaction.label == "Outflow" && newTransaction.amount <= totalInflow)
                    {
                        var outflow = new Outflow
                            {
                                user_id = newTransaction.user_id,
                                outflow_title = newTransaction.title,
                                outflow_amount = newTransaction.amount,
                                outflow_date = newTransaction.date,
                                outflow_note = newTransaction.note,
                                outflow_label = newTransaction.label,
                                outflow_tag = newTransaction.chosen_tag,

                            };
                        await outflowService.AddOutflowAsync(outflow);
                        successMessage = "Successfully added Outflow transaction";
                        messageType = "Success";
                    }
                    else if (newTransaction.label == "Debt")
                    {
                        //object to store debt details
                        var debt = new Debt
                            {
                                user_id = newTransaction.user_id,
                                debt_title = newTransaction.title,
                                debt_amount = newTransaction.amount,
                                debt_date = newTransaction.date,
                                debt_note = newTransaction.note,
                                debt_label = newTransaction.label,
                                debt_tag = newTransaction.chosen_tag,
                                debt_duedate = newTransaction.duedate,
                                debt_source = newTransaction.source,
                                debt_status = "Pending",
                            @* default value *@
                                cleared = false,

                            };
                        await debtService.AddDebtAsync(debt);
                        successMessage = "Successfully added Debt transaction";
                        messageType = "Success";
                    }
                    else
                    {
                        errorMessage = "Please enter valid data  ";
                        messageType = "Error";
                    }
                    


                    
                }
            }
        }
        catch (Exception ex)
        {

            errorMessage = "Error while adding transaction";
            messageType = "Error";
        }
        //if message type is success, successmessage is displayed
        if (messageType == "Success")
        {
            displayMessage = successMessage;
        }
        else 
        {
            displayMessage = errorMessage;
        }
        
    }
}