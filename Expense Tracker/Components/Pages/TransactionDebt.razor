@page "/Debt"
@using Expense_Tracker.Models
@using Expense_Tracker.Services
@inject AuthenticationStateService _authStateService
@inject NavigationManager navigationManager
@inject IDashboardService dashboardService
@inject IDebtService debtService


<div class="container">
    <div class="d-flex flex-column align-items-center">
        <h2 class="text-center fw-bold" style="color:#0f4c7b;">CASH DEBT</h2>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class=" shadow  p-3  mb-2 align-self-center" style="background-color: #197dca; border-radius: 10px;">
                <p class="text-light text-center  fw-bold fs-5">@errorMessage</p>
            </div>
        }
        <div class="background-blue p-3 m-4 text-center">
            <h3 class="fw-bold"><span>Total Amount:</span>@total</h3>
        </div>
        <div class="row">
            <div class="col-md-6">
                <h5 class="text-success">Highest Inflow: @highestDebt</h5>
            </div>
            <div class="col-md-6">
                <h5 class="text-primary">Lowest Inflow: @lowestDebt</h5>
            </div>
        </div>
    </div>
    <div class="row justify-content-evenly" style=" margin: 3%;margin-left: 12%;">
        <div class="col-md-3">
            <label for="startDateRange">Start DueDate Range</label>
            <input type="date" @bind="startDateRange" class="form-control" />
        </div>
        <div class="col-md-3">
            <label for="endDateRange">End DueDate Range</label>
            <input type="date" @bind="endDateRange" class="form-control" />
        </div>
        <div class="col-md-2">
            <label for="filterTag">Filter By Tag</label>
            <select class="form-control" @bind="filterTag">
                <option value="defaultText" selected disabled hidden>Select Tag</option>
                <option value="Gadgets">Gadgets</option>
                <option value="Clothes">Clothes</option>
                <option value="Groceries">Groceries</option>
            </select>
        </div>
        <div class="col-md-2 align-self-center">
            <button class="btn btn-primary mt-4" type="button" @onclick="FilterByDate">Apply Filter</button>
        </div>
        <div class="col-md-2 align-self-center">
            <button class="btn btn-primary mt-4" type="button" @onclick="ClearFilterByDate">Clear Filter</button>
        </div>
    </div>
    <div class="mb-5" style="margin-left: 25%; ">
        <div class="d-flex flex-row">
            <div class="col-md-6">
                <div>
                    <button type="button" class="btn btn-primary" @onclick="OpenTransaction">Add Transaction</button>
                </div>
            </div>
            <div class="col-md-6" style="margin-left:30px;">
                <h5><span class="text-blue">Date:</span>@DateTime.Now.ToString("yyyy-MM-dd")</h5>
            </div>

        </div>
    </div>
    <form class="d-flex" style="width:25%;">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" @bind="searchDebtTitle">
        <button class="btn btn-outline-primary" type="button" @onclick="SearchByTitle">Search</button>
    </form>
</div>
<div class="d-flex justify-content-center align-items-center">
    <div class="container  p-3  shadow rounded " style="margin: 60px;">
        <div class="d-flex flex-row justify-content-around mb-4">
            <div><h5 class="pt-3 fw-bold">Pending Debts</h5></div>

            <div class="dropdown">
                <button class="btn " type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #daecfa; border-style:none; color: #171a1f;">
                    Sort By
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" @onclick="LatestDateDebt">Latest Date</a></li>
                    <li><a class="dropdown-item" @onclick="OldestDateDebt">Oldest Date</a></li>
                    <li><a class="dropdown-item" @onclick="LatestDueDateDebt">Latest Due Date</a></li>
                    <li><a class="dropdown-item" @onclick="OldestDueDateDebt">Oldest Due Date</a></li>
                   
                    
                </ul>
            </div>
        </div>
        <table class="table">
            <thead>
                <tr class="table-primary">
                    <th scope="col">Sn.no</th>
                    <th scope="col">Title</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Date</th>
                    <th scope="col">Due Date</th>
                    <th scope="col">Tag</th>
                    <th scope="col">Labels</th>
                    <th scope="col">Notes</th>
                    <th scope="col">Source</th>
                    <th scope="col">Status</th>
                    <th scope="col">Clear</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int ncounter = 1;
                }
                @if (filterDebtItems == null){
                foreach (var DebtItem in DebtItems)
                {
                    <tr class="table-light">

                        <th scope="row" class="table-light">@ncounter</th>

                        <td class="table-light">@DebtItem.debt_title</td>
                        <td class="table-light">@DebtItem.debt_amount.ToString()</td>
                        <td class="table-light">@DebtItem.debt_date.ToString("yyyy-MM-dd")</td>
                        <td class="table-light">@DebtItem.debt_duedate.ToString("yyyy-MM-dd")</td>
                        <td class="table-light text-primary">@DebtItem.debt_tag</td>
                        <td class="table-light text-warning">@DebtItem.debt_label</td>
                        <td class="table-light">@DebtItem.debt_note</td>
                        <td class="table-light">@DebtItem.debt_source</td>
                        <td class="table-light"><div class="@(DebtItem.debt_status == "Pending"?"btn btn-danger": "btn btn-success")" style="border-radius: 15px; margin:0;color:white;">@DebtItem.debt_status</div></td>
                        <td class="table-light"><button class="btn btn-primary" style="border-radius: 15px; margin:0;color:white;" @onclick="() => ClearDebt(DebtItem)">Clear</button></td>
                        </tr>
                        ncounter++;
                    }
                }
                else
                {
                    foreach (var filterDebtItem in filterDebtItems)
                    {
                        <tr class="table-light">

                            <th scope="row" class="table-light">@ncounter</th>

                            <td class="table-light">@filterDebtItem.debt_title</td>
                            <td class="table-light">@filterDebtItem.debt_amount.ToString()</td>
                            <td class="table-light">@filterDebtItem.debt_date.ToString("yyyy-MM-dd")</td>
                            <td class="table-light">@filterDebtItem.debt_duedate.ToString("yyyy-MM-dd")</td>
                            <td class="table-light text-primary">@filterDebtItem.debt_tag</td>
                            <td class="table-light text-warning">@filterDebtItem.debt_label</td>
                            <td class="table-light">@filterDebtItem.debt_note</td>
                            <td class="table-light">@filterDebtItem.debt_source</td>
                            <td class="table-light"><div class="@(filterDebtItem.debt_status == "Pending"?"btn btn-danger": "btn btn-success")" style="border-radius: 15px; margin:0;color:white;">@filterDebtItem.debt_status</div></td>
                            <td class="table-light"><button class="btn btn-primary" style="border-radius: 15px; margin:0;color:white;" @onclick="() => ClearDebt(filterDebtItem)">Clear</button></td>
                        </tr>
                        ncounter++;
                    }
                }
            </tbody>
        </table>

    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        filterDebtItems = null;
    }
    private void OpenTransaction()
    {
        navigationManager.NavigateTo("/AddTransaction");
    }
    private decimal totalInflow;
    private decimal totalOutflow;
    private decimal total;
    private string errorMessage;
    private string searchDebtTitle;
    private List<Debt> filterDebtItems = new List<Debt>();

    private List<Debt> DebtItems = new List<Debt>();
    protected override async Task OnInitializedAsync()
    {
        await Total();
        await DebtList();
    }
    private DateTime? startDateRange;
    private DateTime? endDateRange;
    private string? filterTag;
    private decimal highestDebt;
    private decimal lowestDebt;
    private List<Debt> debtAmt = new List<Debt>();
    private async Task FilterByDate()
    {
        if (startDateRange.HasValue && endDateRange.HasValue && filterTag!=null)
        {
            DebtItems = DebtItems
                .Where(t => t.debt_duedate >= startDateRange.Value && t.debt_duedate <= endDateRange.Value && t.debt_tag == filterTag) //provide the data
                .ToList();
            errorMessage = "";

        }
        else if (startDateRange.HasValue && endDateRange.HasValue)
        {
            DebtItems = DebtItems
                .Where(t => t.debt_duedate >= startDateRange.Value && t.debt_duedate <= endDateRange.Value ) //provide the data
                .ToList();
            errorMessage = "";
        }
        else
        {
            errorMessage = "All the fields must be filled.";
        }


        StateHasChanged();
    }
    private async Task ClearFilterByDate()
    {
       await OnInitializedAsync();
    }
    private async Task Total()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser();
            int id = authenticatedUser.user_id;
            totalInflow = await dashboardService.CalculateTotalInflowAsync(id);
            totalOutflow = await dashboardService.CalculateTotalOutflowAsync(id);
            (decimal TotalDebt, decimal TotalPending, decimal TotalCleared) = await dashboardService.CalculateTotalDebtAsync(id);
            total = totalInflow + TotalDebt - totalOutflow;
            debtAmt = await debtService.GetDebtsByUserIdAsync(id);
            highestDebt = debtAmt.Max(i => i.debt_amount);
            lowestDebt = debtAmt.Min(i => i.debt_amount);
            errorMessage = "";

        }
        catch (Exception ex)
        {
            errorMessage = "Please try again later. There is some problem while calculating the total";
        }
    }
    private async Task DebtList()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser(); //to get loggedin user id
            int id = authenticatedUser.user_id;
            DebtItems = await debtService.GetDebtsByUserIdAsync(id); //provide the loggedin user id as parameter
             errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = "Please try again later. There is some problem while collecting debt details.";
        }
    }
    private async Task ClearDebt(Debt data)
    {
        if (data.debt_status == "Pending")
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser(); //to get loggedin user id
            int id = authenticatedUser.user_id;
            data.debt_status = "Cleared";
            await debtService.ChangeDebtStatusAsync(data.debtId, id);
            await Total();
            await DebtList();

            StateHasChanged();
        }
        else
        {
            errorMessage = "Already cleared";
        }
    }
    private async Task SearchByTitle()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser(); //to get loggedin user id
            int id = authenticatedUser.user_id;
            filterDebtItems = await debtService.GetDebtsByTitleAsync(searchDebtTitle, id);


            if (filterDebtItems == null)
            {
                errorMessage = "No matched title found.";

                StateHasChanged();
            }
            else
            {
                errorMessage = null; 
            }

        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while retrieving the debts";
            Console.WriteLine(errorMessage);
        }
    }
    private async Task LatestDateDebt()
    {
        @if (filterDebtItems == null)
        {
            DebtItems = DebtItems.OrderByDescending(d => d.debt_date).ToList();
        }
        else
        {
            filterDebtItems = filterDebtItems.OrderByDescending(d => d.debt_date).ToList();
        }
    }
    private async Task OldestDateDebt()
    {
        @if (filterDebtItems == null)
        {
            DebtItems = DebtItems.OrderBy(d => d.debt_date).ToList();
        }
        else
        {
            filterDebtItems = filterDebtItems.OrderBy(d => d.debt_date).ToList();
        }
    }
    private async Task LatestDueDateDebt()
    {
        @if (filterDebtItems == null)
        {
            DebtItems = DebtItems.OrderByDescending(d => d.debt_duedate).ToList();
        }
        else
        {
            filterDebtItems = filterDebtItems.OrderByDescending(d => d.debt_duedate).ToList();
        }
    }
    private async Task OldestDueDateDebt()
    {
        @if (filterDebtItems == null)
        {
            DebtItems = DebtItems.OrderBy(d => d.debt_duedate).ToList();
        }
        else
        {
            filterDebtItems = filterDebtItems.OrderBy(d => d.debt_duedate).ToList();
        }
    }
   
    
    
    
}
 