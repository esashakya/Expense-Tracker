@page "/Debt"
@using Expense_Tracker.Models
@using Expense_Tracker.Services
@inject AuthenticationStateService _authStateService
@inject NavigationManager navigationManager
@inject IDashboardService dashboardService
@inject IDebtService debtService
<div class="container">
    <div class="d-flex flex-column align-items-center">
        <h2 class="text-center fw-bold" style="color:#0f4c7b;">CASH DEBT</h2>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class=" shadow  p-3  mb-2 align-self-center" style="background-color: #197dca; border-radius: 10px;">
                <p class="text-light text-center  fw-bold fs-5">@errorMessage</p>
            </div>
        }
        <div class="background-blue p-3 m-4 text-center">
            <h3 class="fw-bold"><span>Total Amount:</span>@total</h3>
        </div>
    </div>
    <div class="mb-5" style="margin-left: 25%; ">
        <div class="d-flex flex-row">
            <div class="col-md-6">
                <div>
                    <button type="button" class="btn btn-primary" @onclick="OpenTransaction">Add Transaction</button>
                </div>
            </div>
            <div class="col-md-6" style="margin-left:30px;">
                <h5><span class="text-blue">Date:</span>@DateTime.Now.ToString("yyyy-MM-dd")</h5>
            </div>

        </div>
    </div>
    <form class="d-flex" style="width:25%;">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
        <button class="btn btn-outline-primary" type="submit">Search</button>
    </form>
</div>
<div class="d-flex justify-content-center align-items-center">
    <div class="container  p-3  shadow rounded " style="margin: 60px;">
        <div class="d-flex flex-row justify-content-around mb-4">
            <div><h5 class="pt-3 fw-bold">Pending Debts</h5></div>

            <div class="dropdown">
                <button class="btn " type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #daecfa; border-style:none; color: #171a1f;">
                    Sort By
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#">Date</a></li>
                    <li><a class="dropdown-item" href="#">Highest</a></li>
                    <li><a class="dropdown-item" href="#">Lowest</a></li>
                </ul>
            </div>
        </div>
        <table class="table">
            <thead>
                <tr class="table-primary">
                    <th scope="col">Sn.no</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Date</th>
                    <th scope="col">Due Date</th>
                    <th scope="col">Tag</th>
                    <th scope="col">Labels</th>
                    <th scope="col">Notes</th>
                    <th scope="col">Source</th>
                    <th scope="col">Status</th>
                    <th scope="col">Clear</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int ncounter = 1;
                }
                @foreach (var DebtItem in DebtItems)
                {
                    <tr class="table-light">

                        <th scope="row" class="table-light">@ncounter</th>


                        <td class="table-light">@DebtItem.debt_amount.ToString()</td>
                        <td class="table-light">@DebtItem.debt_date.ToString("yyyy-MM-dd")</td>
                        <td class="table-light">@DebtItem.debt_duedate.ToString("yyyy-MM-dd")</td>
                        <td class="table-light text-primary">@DebtItem.debt_tag</td>
                        <td class="table-light text-warning">@DebtItem.debt_label</td>
                        <td class="table-light">@DebtItem.debt_label</td>
                        <td class="table-light">@DebtItem.debt_source</td>
                        <td class="table-light"><div class="@(DebtItem.debt_status == "Pending"?"btn btn-danger": "btn btn-success")" style="border-radius: 15px; margin:0;color:white;">@DebtItem.debt_status</div></td>
                        <td class="table-light"><button class="btn btn-primary" style="border-radius: 15px; margin:0;color:white;" @onclick="() => ClearDebt(DebtItem)" >Clear</button></td>
                    </tr>
                    ncounter++;
                }
            </tbody>
        </table>

    </div>
</div>

@code {

    private void OpenTransaction()
    {
        navigationManager.NavigateTo("/AddTransaction");
    }
    private decimal totalInflow;
    private decimal totalOutflow;
    private decimal total;
    private string errorMessage;

    private List<Debt> DebtItems = new List<Debt>();
    protected override async Task OnInitializedAsync()
    {
        await Total();
        await DebtList();
    }
    private async Task Total()
    {
        try
        {
            totalInflow = await dashboardService.CalculateTotalInflowAsync();
            totalOutflow = await dashboardService.CalculateTotalOutflowAsync();
            (decimal TotalDebt, decimal TotalPending, decimal TotalCleared) = await dashboardService.CalculateTotalDebtAsync();
            total = totalInflow + TotalDebt - totalOutflow;

        }
        catch (Exception ex)
        {
            
        }
    }
    private async Task DebtList()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser(); //to get loggedin user id
            int id = authenticatedUser.user_id;
            DebtItems = await debtService.GetDebtsByUserIdAsync(id); //provide the loggedin user id as parameter
        }
        catch (Exception ex)
        {
            
        }
    }
    private async Task ClearDebt(Debt DebtItem)
    {
        if (DebtItem.debt_status == "Pending")
        {
            DebtItem.debt_status = "Cleared";
        }
        else
        {
            errorMessage = "Already cleared";
        }
    }
}
