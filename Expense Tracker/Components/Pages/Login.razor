@page "/"

@using Expense_Tracker.Models
@using Expense_Tracker.Services
@inject IUserService userService
@inject NavigationManager navigationManager
@inject AuthenticationStateService authStateService

<div class="container mt-4">
    <div class="d-flex flex-row">
        <div class="col-md-6 mt-5 d-flex flex-column">
            <h2 class="text-center">Sign In</h2>
            <h5 class="fw-light text-center mt-4">Welcome Back</h5>
            <div class="mt-2">
                <form>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" id="email" class="form-control" @bind="user_email" />
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" id="password" class="form-control" @bind="password" />
                    </div>
                    
                    <div class="align-items-center">
                        <button type="button" class="btn btn-primary w-100 " @onclick="LoginDetails">Sign In</button>
                    </div>
                    <hr />
                    <div>
                        <p class="text-center">Don't' have an account?<a href="/SignUp">Sign Up</a></p>
                    </div>

                </form>
                @if (!string.IsNullOrEmpty(errorLoginMessage))
                {
                    <p class="error-message text-danger text-center bg-light">@errorLoginMessage</p>
                }
            </div>
        </div>
        <div class="col-md-6 mt-4 ms-4 d-flex justify-content-center">
            <img src="/registration.jpg" class="ms-2" style="max-width: 90%; height: 90%;" />
        </div>
    </div>
</div>


@code {
    private string user_email;
    private string password;
    private string errorLoginMessage;

    private async Task LoginDetails()
    {
        try
        {
            Console.WriteLine("Login check");
            var users = await userService.LoadUsersAsync();
            var user = users.FirstOrDefault(u => u.user_email == user_email && u.password == HashPassword(password));

            if (user != null)
            {
                // Set the authenticated user in state management
                authStateService.SetAuthenticatedUser(user);

                // Redirect to the dashboard or todo page
                navigationManager.NavigateTo("/Dashboard");
            }
            else
            {
                errorLoginMessage = "Username or password is incorrect.Please try again";
            }
        }
        catch (Exception ex)
        {
            errorLoginMessage = $"An error occurred during login: {ex.Message}";
        }
    }

    private string HashPassword(string password)
    {
        using (var sha256 = System.Security.Cryptography.SHA256.Create())
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(password);
            var hash = sha256.ComputeHash(bytes);
            return Convert.ToBase64String(hash);
        }
    }
}
