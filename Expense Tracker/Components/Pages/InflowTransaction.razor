@page "/Inflow"
@using Expense_Tracker.Models
@using Expense_Tracker.Services
@inject AuthenticationStateService _authStateService
@inject NavigationManager navigationManager
@inject IDashboardService dashboardService
@inject IInflowService inflowService
<div class="container">
    <div class="d-flex flex-column align-items-center">
        <h2 class="text-center fw-bold" style="color:#0f4c7b;">CASH INFLOW</h2>
        <div class="background-blue p-3 m-4 text-center">
            <h3 class="fw-bold"><span>Total Amount:</span>@total</h3>
        </div>
    </div>
    <div class="mb-5" style="margin-left: 25%; ">
        <div class="d-flex flex-row">
            <div class="col-md-6">
                <div>
                    <button type="button" class="btn btn-primary" @onclick="OpenTransaction">Add Transaction</button>
                </div>
            </div>
            <div class="col-md-6" style="margin-left:30px;">
                <h5><span class="text-blue">Date:</span>@DateTime.Now.ToString("yyyy-MM-dd")</h5>
            </div>

        </div>
    </div>
        <form class="d-flex" style="width:25%;">
            <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
            <button class="btn btn-outline-primary" type="submit">Search</button>
        </form>
    </div>
    <div class="d-flex justify-content-center align-items-center">
    <div class="container m-4 p-3 mt-3 shadow rounded" style="margin-left: 25%;">
                <div class="d-flex flex-row justify-content-end mb-3">
                    


                    <div class="dropdown">
                        <button class="btn " type="button"  data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #daecfa; border-style:none; color: #171a1f;">
                            Sort By
                        </button>
                        <ul class="dropdown-menu" >
                            <li><a class="dropdown-item" href="#">Date</a></li>
                            <li><a class="dropdown-item" href="#">Highest</a></li>
                            <li><a class="dropdown-item" href="#">Lowest</a></li>
                        </ul>
                    </div>
                </div>
                <table class="table">
                  <thead>
                     <tr class="table-primary">
                      <th scope="col">Sn.no</th>
                      <th scope="col">Amount</th>
                      <th scope="col">Date</th>
                      <th scope="col">Tag</th>
                      <th scope="col">Labels</th>
                      <th scope="col">Notes</th>
                    </tr>
                  </thead>
                  <tbody>
                        @{
                            int counter = 1;
                        }
                        @foreach (var InflowItem in InflowItems)
                        {
                            <tr class="table-light">

                            <th scope="row" class="table-light">@counter</th>


                                <td class="table-light">@InflowItem.inflow_amount.ToString()</td>
                                <td class="table-light">@InflowItem.inflow_date.ToString("yyyy-MM-dd")</td>
                                <td class="table-light text-primary">@InflowItem.inflow_tag</td>
                                <td class="table-light text-success">@InflowItem.inflow_label</td>
                                <td class="table-light">@InflowItem.inflow_note</td>
                        </tr>
                        counter++;
                        }
                </tbody>
                </table>
                 
            </div>
</div>


@code {

    private void OpenTransaction()
    {
        navigationManager.NavigateTo("/AddTransaction");
    }
    private decimal totalInflow;
    private decimal totalOutflow;
    private decimal total;
    private string errorMessage;
    private List<Inflow> InflowItems = new List<Inflow>();
    protected override async Task OnInitializedAsync()
    {
        await Total();
        await InflowList();
    }
    private async Task Total()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser();
            int id = authenticatedUser.user_id;
            totalInflow = await dashboardService.CalculateTotalInflowAsync(id);
            totalOutflow = await dashboardService.CalculateTotalOutflowAsync(id);
            (decimal TotalDebt, decimal TotalPending, decimal TotalCleared) = await dashboardService.CalculateTotalDebtAsync(id);
            total = totalInflow + TotalDebt - totalOutflow;

        }
        catch (Exception ex)
        {
            errorMessage = "Please refresh the page.";
        }
    }
    private async Task InflowList()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser();
            int id = authenticatedUser.user_id;
            InflowItems = await inflowService.GetInflowsByUserIdAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = "Please refresh the page.";
        }
    }
}