@page "/Inflow"
@using Expense_Tracker.Models
@using Expense_Tracker.Services
@inject AuthenticationStateService _authStateService
@inject NavigationManager navigationManager
@inject IDashboardService dashboardService
@inject IInflowService inflowService
<div class="container">
    <div class="d-flex flex-column align-items-center">
        <h2 class="text-center fw-bold" style="color:#0f4c7b;">CASH INFLOW</h2>
        <div class="background-blue p-3 m-4 text-center">
            <h3 class="fw-bold"><span>Total Amount:</span>@total</h3>
        </div>
        <div class="row">
            <div class="col-md-6">
                <h5 class="text-success">Highest Inflow: @highestInflow</h5>
            </div>
            <div class="col-md-6">
                <h5 class="text-primary">Lowest Inflow: @lowestInflow</h5>
            </div>
        </div>
    </div>
    <div class="row justify-content-evenly" style=" margin: 3%;margin-left: 12%;">
        <div class="col-md-3">
            <label for="startDateRange">Start Date Range</label>
            <input type="date" @bind="startDateRange" class="form-control" />
        </div>
        <div class="col-md-3">
            <label for="endDateRange">End Date Range</label>
            <input type="date" @bind="endDateRange" class="form-control" />
        </div>
        <div class="col-md-2">
            <label for="filterTag">Filter By Tag</label>
            <select class="form-control" @bind="filterTag">
                 <option value="defaultText" selected disabled hidden>Select Tag</option>
                 <option value="Gadgets">Gadgets</option>
                <option value="Clothes">Clothes</option>
                <option value="Clothes">Groceries</option>
           </select>
        </div>
        <div class="col-md-2 align-self-center">
            <button class="btn btn-primary mt-4" type="button" @onclick="FilterByDate">Apply Filter</button>
        </div>
        <div class="col-md-2 align-self-center">
            <button class="btn btn-primary mt-4" type="button" @onclick="ClearFilterByDate">Clear Filter</button>
        </div>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class=" shadow  p-1  mb-2 align-self-center" style="background-color: #197dca; border-radius: 7px;">
                <p class="text-light text-center  fw-bold ">@errorMessage</p>
            </div>
        }
    </div>
    <div class="mb-5" style="margin-left: 25%; ">
        <div class="d-flex flex-row">
            <div class="col-md-6">
                <div>
                    <button type="button" class="btn btn-primary" @onclick="OpenTransaction">Add Transaction</button>
                </div>
            </div>
            <div class="col-md-6" style="margin-left:30px;">
                <h5><span class="text-blue">Date:</span>@DateTime.Now.ToString("yyyy-MM-dd")</h5>
            </div>

        </div>
    </div>
        <form class="d-flex" style="width:25%;">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" @bind="searchInflowTitle">
        <button class="btn btn-outline-primary" type="button" @onclick="SearchByTitle">Search</button>
        </form>
    </div>
    <div class="d-flex justify-content-center align-items-center">
    <div class="container m-4 p-3 mt-3 shadow rounded" style="margin-left: 25%;">
                <div class="d-flex flex-row justify-content-end mb-3">
                    


                    <div class="dropdown">
                        <button class="btn " type="button"  data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #daecfa; border-style:none; color: #171a1f;">
                            Sort By
                        </button>
                        <ul class="dropdown-menu" >
                            <li><a class="dropdown-item" @onclick="LatestDateInflow">Latest Date</a></li>
                            <li><a class="dropdown-item" @onclick="OldestDateInflow">Oldest Date</a></li>
                            
                        </ul>
                    </div>
                </div>
                <table class="table">
                  <thead>
                     <tr class="table-primary">
                      <th scope="col">Sn.no</th>
                      <th scope="col">Title</th>
                      <th scope="col">Amount</th>
                      <th scope="col">Date</th>
                      <th scope="col">Tag</th>
                      <th scope="col">Labels</th>
                      <th scope="col">Notes</th>
                    </tr>
                  </thead>
                  <tbody>
                        @{
                            int counter = 1;
                        }
                        @if (filterInflowItems == null){
                            foreach (var InflowItem in InflowItems)
                            {
                                <tr class="table-light">

                                <th scope="row" class="table-light">@counter</th>

                                    <td class="table-light">@InflowItem.inflow_title</td>
                                    <td class="table-light">@InflowItem.inflow_amount.ToString()</td>
                                    <td class="table-light">@InflowItem.inflow_date.ToString("yyyy-MM-dd")</td>
                                    <td class="table-light text-primary">@InflowItem.inflow_tag</td>
                                    <td class="table-light text-success">@InflowItem.inflow_label</td>
                                    <td class="table-light">@InflowItem.inflow_note</td>
                                </tr>
                                counter++;
                            }
                        }
                        else
                        {
                            foreach (var filterInflowItem in filterInflowItems)
                            {
                                <tr class="table-light">

                                    <th scope="row" class="table-light">@counter</th>

                                    <td class="table-light">@filterInflowItem.inflow_title</td>
                                    <td class="table-light">@filterInflowItem.inflow_amount.ToString()</td>
                                    <td class="table-light">@filterInflowItem.inflow_date.ToString("yyyy-MM-dd")</td>
                                    <td class="table-light text-primary">@filterInflowItem.inflow_tag</td>
                                    <td class="table-light text-success">@filterInflowItem.inflow_label</td>
                                    <td class="table-light">@filterInflowItem.inflow_note</td>
                                </tr>
                                counter++;
                            }

                    
                }
            </tbody>
                </table>
                 
            </div>
</div>


@code {
    protected override void OnInitialized()
    {
        filterInflowItems = null; //initializing the filteritems to be null
    }

    private void OpenTransaction()
    {
        navigationManager.NavigateTo("/AddTransaction"); //this method is called to open add transaction page
    }
    private decimal totalInflow;
    private decimal totalOutflow;
    private decimal highestInflow;
    private decimal lowestInflow;
    private decimal total;
    private string errorMessage;
    private string searchInflowTitle;
    private List<Inflow> filterInflowItems = new List<Inflow>();
    private List<Inflow> InflowItems = new List<Inflow>();
    private List<Inflow> inflowAmt = new List<Inflow>();
    protected override async Task OnInitializedAsync()
    {
        await Total();
        await InflowList();

    }
    private DateTime? startDateRange;
    private DateTime? endDateRange;
    private string filterTag;
    private async Task FilterByDate()
    {
        //filter according to the date range and tag
        if (startDateRange.HasValue && endDateRange.HasValue && filterTag !=null)
        {
            InflowItems = InflowItems
                .Where(t => t.inflow_date >= startDateRange.Value && t.inflow_date <= endDateRange.Value && t.inflow_tag == filterTag) //provide the data
                .ToList();
            errorMessage = "";

        }
        else if (startDateRange.HasValue && endDateRange.HasValue)
        {
            InflowItems = InflowItems
                .Where(t => t.inflow_date >= startDateRange.Value && t.inflow_date <= endDateRange.Value) //provide the data
                .ToList();
            errorMessage = "";
        }
        else
        {
            errorMessage = "All the fields must be filled.";
        }


        StateHasChanged();
    }
    private async Task SearchByTitle()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser(); //to get loggedin user id
            int id = authenticatedUser.user_id;
            filterInflowItems = await inflowService.GetInflowsByTitleAsync(searchInflowTitle, id);


            if (filterInflowItems == null)
            {
                errorMessage = "No matched title found.";


            }
            else
            {
                errorMessage = null;
            }
            StateHasChanged();

        }
        catch (Exception ex)
        {
            errorMessage = "Please refresh the page.";
        }
    }
    private async Task ClearFilterByDate()
    {
        await OnInitializedAsync();
    }
    private async Task Total()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser();
            int id = authenticatedUser.user_id;
            totalInflow = await dashboardService.CalculateTotalInflowAsync(id);
            totalOutflow = await dashboardService.CalculateTotalOutflowAsync(id);
            (decimal TotalDebt, decimal TotalPending, decimal TotalCleared) = await dashboardService.CalculateTotalDebtAsync(id);
            total = totalInflow + TotalDebt - totalOutflow;
            inflowAmt = await inflowService.GetInflowsByUserIdAsync(id);
            highestInflow = inflowAmt.Max(i => i.inflow_amount);
            lowestInflow = inflowAmt.Min(i => i.inflow_amount);

        }
        catch (Exception ex)
        {
           
        }
    }
    private async Task InflowList()
    {
        try
        {
            var authenticatedUser = _authStateService.GetAuthenticatedUser();
            int id = authenticatedUser.user_id;
            InflowItems = await inflowService.GetInflowsByUserIdAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = "Please reload the page after few minutes.";
        }
    }
    private async Task LatestDateInflow()
    {
        if (filterInflowItems == null)
        {
            InflowItems = InflowItems.OrderByDescending(d => d.inflow_date).ToList();//if filter is not applied
        }
        else
        {
            filterInflowItems = filterInflowItems.OrderByDescending(d => d.inflow_date).ToList(); //if filter is applied
        }
    }
    private async Task OldestDateInflow()
    {
        if (filterInflowItems == null)
        {
            InflowItems = InflowItems.OrderBy(d => d.inflow_date).ToList();
        }
        else
        {
            filterInflowItems = filterInflowItems.OrderBy(d => d.inflow_date).ToList();
        }
    }
    
}